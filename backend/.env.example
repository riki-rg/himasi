# ─── Aplikasi ────────────────────────────────────────────────────────────────
APP_NAME="HIMSI UMKU API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

# ─── Database ────────────────────────────────────────────────────────────────
# Dev lokal: sqlite (zero config)
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Deploy VM nanti — pilih salah satu, lalu isi kredensial:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=himsi_umku
# DB_USERNAME=himsi
# DB_PASSWORD=

# atau PostgreSQL:
# DB_CONNECTION=pgsql
# DB_PORT=5432
# DB_HOST=127.0.0.1
# DB_DATABASE=himsi_umku
# DB_USERNAME=himsi
# DB_PASSWORD=

# ─── Session / Cache / Queue (dev) ──────────────────────────────────────────
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Mail (ADR D8 — dev pakai log; production ganti SMTP/Resend via env) ────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="himsi@umku.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Frontend origins (Sanctum stateful — isi saat app komunitas live) ──────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,localhost:3002
FRONTEND_URL=http://localhost:3000

# ─── File storage ────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public
